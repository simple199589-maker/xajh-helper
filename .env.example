# Copy to .env (gitignored). Process environment variables override these.
# Used by: tools\build_gui.bat, source runs (not frozen packages for .env file).

# Business API host (identify / license / cloud-control share this by default)
# Packaged builds bake this from env at build time (build_profile.json is cache only).
XAJH_CAPTCHA_BASE_URL=https://xiaoao.joini.cloud
XAJH_CAPTCHA_API_KEY=

# Optional: only if license is on a different host. Empty = same as XAJH_CAPTCHA_BASE_URL.
# XAJH_LICENSE_BASE_URL=

# Optional HMAC for login/unbind; leave blank when the server does not require it.
# Build/pack only: embedded into binary via tools/_write_build_profile.py
# Never shipped as plain build_profile.json. Source runs may use .env.
XAJH_LICENSE_API_SECRET=
# Re-verify interval seconds (default 1800 for both channels):
# XAJH_LICENSE_REVERIFY_S=

# Optional channel override for local runs (dev|prod). Leave unset to use
# build_profile.json / source defaults.
# XAJH_BUILD_CHANNEL=

# Cloud control / captcha / license: same base URL above.
# Paths: /api/identify/*, /api/license/*, /api/cloud-control/*
